# =============================================
# DEPENDENCIES
# =============================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =============================================
# NEXT.JS BUILD & CACHE
# =============================================
.next/
out/
build/
.next/trace
.next/static
*.tsbuildinfo
next-env.d.ts

# =============================================
# TURBOPACK CACHE
# =============================================
.next/dev/cache/turbopack/
.next/dev/turbopack/

# =============================================
# PRISMA (generated client is in node_modules; migrations are tracked)
# =============================================
lib/generated/prisma/
prisma/generated/

# =============================================
# ENVIRONMENT FILES (DO NOT COMMIT — may contain secrets)
# =============================================
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.example

# =============================================
# LOGS
# =============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================
# IDE & EDITOR
# =============================================
.vscode/
.idea/
*.swp
*.swo
*~
.vscode/settings.json
.idea/workspace.xml

# =============================================
# OS FILES
# =============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =============================================
# TESTING & COVERAGE
# =============================================
/coverage/
/.nyc_output/
__pycache__/
*.pyc

# =============================================
# DEPLOYMENT
# =============================================
.vercel/
.netlify/
firebase.json
*.pem

# =============================================
# TEMPORARY FILES
# =============================================
*.tmp
*.temp
*.bak
*.orig
*~

# =============================================
# MISC GENERATED / RUNTIME
# =============================================
/playwright-report/
/test-results/
nul
