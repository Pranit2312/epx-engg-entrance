// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                             @id @default(cuid())
  email                         String                             @unique
  password                      String
  name                          String?
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  attempts                      Attempt[]
  answerRecords                 UserMockTestQuestionAttemptAnswer[]
}

model MockTest {
  id              String      @id @default(cuid())
  name            String
  examType        ExamType
  subject         String
  duration        Int
  totalQuestions  Int
  difficulty      Difficulty
  description     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  questions       Question[]
  attempts        Attempt[]
}

model Question {
  id            String    @id @default(cuid())
  mockTestId    String
  mockTest      MockTest  @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionText  String
  options       String[]
  correctOption Int
  explanation   String?
  order         Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Attempt {
  id                            String                             @id @default(cuid())
  userId                        String
  user                          User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId                    String
  mockTest                      MockTest                           @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  score                         Int
  correct                       Int
  incorrect                     Int
  accuracy                      Float
  timeTaken                     Int
  answers                       Json
  markedForReview               String[]
  status                        AttemptStatus
  startedAt                     DateTime
  submittedAt                   DateTime?
  createdAt                     DateTime                           @default(now())
  updatedAt                     DateTime                           @updatedAt
  answerRecords                 UserMockTestQuestionAttemptAnswer[]

  @@unique([userId, mockTestId])
}

model UserMockTestQuestionAttemptAnswer {
  id              String   @id @default(cuid())
  userId          String
  attemptId       String
  questionId      String
  selectedOption  Int?
  markedForReview Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

enum ExamType {
  JEE_MAIN
  JEE_ADVANCED
  MHT_CET
  NEET
  OTHER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
